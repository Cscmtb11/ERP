# Template only — never commit production secrets.
ERPNEXT_BRANCH=version-16
PUBLIC_HOSTNAME=erp.springnexa.in
CUSTOM_IMAGE=springnexa/erpnext:v16
TIMEZONE=Asia/Kolkata

# Provisioning baseline; select actual VPS plan before deployment.
VPS_OS=Ubuntu-24.04
VPS_VCPU=4
VPS_RAM_GB=8
VPS_DISK_GB=160

# Set secrets directly on the VPS in a chmod-600 environment file.
# Do not add DB_PASSWORD, ADMIN_PASSWORD, API keys, tokens, certificates,
# database dumps or Frappe site files to this repository.
