# Template only — never commit production secrets.
ERPNEXT_BRANCH=version-16
PUBLIC_HOSTNAME=erp.springnexa.in
CUSTOM_IMAGE=springnexa/erpnext:v16
TIMEZONE=Asia/Kolkata

# OCI Always Free target; verify eligibility in the OCI Console.
OCI_REGION=YOUR_TENANCY_HOME_REGION
OCI_SHAPE=VM.Standard.A1.Flex
OCI_ARCH=arm64
OCI_OCPUS=2
OCI_RAM_GB=12
OCI_BOOT_VOLUME_GB=100
OCI_OS=Ubuntu-24.04-ARM64

# Set secrets only on the OCI VM in a chmod-600 environment file.
# Never add DB_PASSWORD, ADMIN_PASSWORD, API keys, tokens, certificates,
# database dumps, site backups or Frappe site files to this repository.
